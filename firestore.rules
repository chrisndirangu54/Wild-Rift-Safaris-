rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function isAdmin(){return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));}
  match /inquiries/{id} {
   allow create: if signedIn() && request.resource.data.keys().hasOnly(['userId','displayName','email','message','interest','budget','days','createdAt','status']) && request.resource.data.userId == request.auth.uid && request.resource.data.email == request.auth.token.email && request.resource.data.status == 'new' && request.resource.data.message is string && request.resource.data.message.size() >= 10 && request.resource.data.message.size() <= 2000 && request.resource.data.budget is string && request.resource.data.budget.size() <= 50 && request.resource.data.days is int && request.resource.data.days >= 1 && request.resource.data.days <= 14 && request.resource.data.createdAt == request.time;
   allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
   allow update,delete: if isAdmin();
  }
  match /admins/{uid}{allow read: if isAdmin();allow write: if false;}
  match /{document=**}{allow read,write: if false;}
 }
}