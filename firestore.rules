rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function isOwner(uid){return signedIn() && request.auth.uid == uid;}
  function isAdmin(){return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));}
  match /admins/{uid}{allow read: if isOwner(uid) || isAdmin();allow write: if false;}
  match /users/{uid}{
   allow create: if isOwner(uid) && request.resource.data.email == request.auth.token.email;
   allow read: if isOwner(uid) || isAdmin();
   allow update: if isOwner(uid) && request.resource.data.email == request.auth.token.email || isAdmin();
   allow delete: if isAdmin();
   match /favorites/{favoriteId}{allow read,create,delete: if isOwner(uid);allow update: if false;}
  }
  match /journeys/{id}{
   allow create: if signedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.keys().hasOnly(['userId','interest','days','budget','stopIds','createdAt','status']) && request.resource.data.days is int && request.resource.data.days >= 1 && request.resource.data.days <= 14 && request.resource.data.budget is string && request.resource.data.budget.size() <= 50 && request.resource.data.stopIds is list && request.resource.data.stopIds.size() <= 14 && request.resource.data.status == 'draft' && request.resource.data.createdAt == request.time;
   allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
   allow update,delete: if isAdmin();
  }
  match /bookingRequests/{id}{
   allow create: if signedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.email == request.auth.token.email && request.resource.data.keys().hasOnly(['userId','email','destinationId','startDate','partySize','notes','status','createdAt']) && request.resource.data.partySize is int && request.resource.data.partySize >= 1 && request.resource.data.partySize <= 30 && request.resource.data.notes is string && request.resource.data.notes.size() <= 1500 && request.resource.data.status == 'requested' && request.resource.data.createdAt == request.time;
   allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
   allow update,delete: if isAdmin();
  }
  match /inquiries/{id}{
   allow create: if signedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.email == request.auth.token.email && request.resource.data.status == 'new' && request.resource.data.message is string && request.resource.data.message.size() >= 10 && request.resource.data.message.size() <= 2000 && request.resource.data.createdAt == request.time;
   allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());allow update,delete: if isAdmin();
  }
  match /publicContent/{id}{allow read: if true;allow write: if isAdmin();}
  match /{document=**}{allow read,write: if false;}
 }
}