rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function owner(uid){return signedIn() && request.auth.uid == uid;}
  function admin(){return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));}
  function superAdmin(){return signedIn() && request.auth.token.superAdmin == true;}
  match /admins/{uid}{allow read: if owner(uid) || admin();allow write: if false;}
  match /authorizedWildlifeSources/{id}{allow read,write: if superAdmin();}
  match /xpAwards/{id}{allow read: if signedIn() && (resource.data.userId == request.auth.uid || admin());allow write: if false;}
  match /wildlifeEvents/{id}{allow read: if signedIn() && (resource.data.reviewStatus == 'verified' || admin());allow write: if false;}
  match /wildlifeSamples/{id}{allow read: if admin();allow write: if false;}
  match /dynamicQuests/{id}{allow read: if signedIn();allow write: if false;}
  match /explorerProgress/{uid}{allow read: if owner(uid) || admin();allow write: if false;}
  match /notificationQueue/{id}{allow read: if admin();allow write: if false;}
  match /pipelineErrors/{id}{allow read: if admin();allow write: if false;}
  match /wildlifeSamplerState/{id}{allow read: if admin();allow write: if false;}
  match /wildlifeUsage/{id}{allow read: if admin();allow write: if false;}
  match /twinNodes/{id}{allow read: if signedIn() && (resource.data.status == 'published' || admin());allow write: if false;}
  match /twinEdges/{id}{allow read: if signedIn() && (resource.data.status == 'published' || admin());allow write: if false;}
  match /graphCandidates/{id}{allow read: if admin();allow write: if false;}
  match /graphIngestionJobs/{id}{allow read: if admin();allow write: if false;}
  match /users/{uid}{
   allow create: if owner(uid) && request.resource.data.email == request.auth.token.email;
   allow read: if owner(uid) || admin();
   allow update: if (owner(uid) && request.resource.data.email == request.auth.token.email) || admin();
   allow delete: if admin();
   match /favorites/{favoriteId}{allow read,create,delete: if owner(uid);allow update: if false;}
  }
  match /journeys/{id}{
   allow create: if signedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.days is int && request.resource.data.days >= 1 && request.resource.data.days <= 14 && request.resource.data.status == 'draft' && request.resource.data.createdAt == request.time;
   allow read: if signedIn() && (resource.data.userId == request.auth.uid || admin());
   allow update,delete: if admin();
  }
  match /bookingRequests/{id}{
   allow create: if signedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.email == request.auth.token.email && request.resource.data.partySize is int && request.resource.data.partySize >= 1 && request.resource.data.partySize <= 30 && request.resource.data.notes is string && request.resource.data.notes.size() <= 1500 && request.resource.data.status == 'requested' && request.resource.data.createdAt == request.time;
   allow read: if signedIn() && (resource.data.userId == request.auth.uid || admin());
   allow update,delete: if admin();
  }
  match /inquiries/{id}{allow create: if signedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.email == request.auth.token.email && request.resource.data.status == 'new' && request.resource.data.createdAt == request.time;allow read: if signedIn() && (resource.data.userId == request.auth.uid || admin());allow update,delete: if admin();}
  match /guideApplications/{id}{
 allow create: if signedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.email == request.auth.token.email && request.resource.data.status == 'pending' && request.resource.data.createdAt == request.time;
 allow read: if signedIn() && (resource.data.userId == request.auth.uid || admin());
 allow update,delete: if admin();
}
match /storyRenders/{id}{
 allow create: if signedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.email == request.auth.token.email && request.resource.data.visibility == 'private' && request.resource.data.publishConsent == false && request.resource.data.status == 'director-plan' && request.resource.data.createdAt == request.time;
 allow read: if signedIn() && (resource.data.userId == request.auth.uid || admin());
 allow update,delete: if signedIn() && (resource.data.userId == request.auth.uid || admin());
}
match /tripStories/{id}{
 allow create: if signedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.email == request.auth.token.email && request.resource.data.visibility == 'private' && request.resource.data.publishConsent == false && request.resource.data.mapPrecision == 'generalized' && request.resource.data.createdAt == request.time;
 allow read: if signedIn() && (resource.data.userId == request.auth.uid || admin());
 allow update,delete: if signedIn() && (resource.data.userId == request.auth.uid || admin());
}
match /questEvidence/{id}{
 allow create: if signedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.email == request.auth.token.email && request.resource.data.visibility == 'private' && request.resource.data.publishConsent == false && request.resource.data.precision == 'obscured' && request.resource.data.verification == 'unverified' && request.resource.data.guideVouches == 0 && request.resource.data.xpAwarded == 0 && request.resource.data.createdAt == request.time;
 allow read: if signedIn() && (resource.data.userId == request.auth.uid || admin());
 allow update: if admin() || (signedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == resource.data.userId && request.resource.data.verification == resource.data.verification && request.resource.data.guideVouches == resource.data.guideVouches);
 allow delete: if signedIn() && (resource.data.userId == request.auth.uid || admin());
}
match /emergencyRequests/{id}{
 allow create: if false;
 allow read: if signedIn() && (resource.data.userId == request.auth.uid || admin());
 allow update,delete: if admin();
}
match /sightings/{id}{
 allow create: if signedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.email == request.auth.token.email && request.resource.data.precision == 'obscured' && request.resource.data.verification == 'unverified' && request.resource.data.guideVouches == 0 && request.resource.data.xp == 0 && request.resource.data.createdAt == request.time;
 allow read: if signedIn() && (resource.data.userId == request.auth.uid || admin());
 allow update,delete: if admin();
}
match /observations/{id}{allow create: if signedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.precision == 'obscured' && request.resource.data.species is string && request.resource.data.species.size() <= 100 && request.resource.data.place is string && request.resource.data.place.size() <= 100 && request.resource.data.createdAt == request.time;allow read: if signedIn() && (resource.data.userId == request.auth.uid || admin());allow update,delete: if admin();}\n  match /transferRequests/{id}{allow create: if signedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.email == request.auth.token.email && request.resource.data.status == 'requested' && request.resource.data.passengers is int && request.resource.data.passengers >= 1 && request.resource.data.passengers <= 50 && request.resource.data.luggage is int && request.resource.data.luggage >= 0 && request.resource.data.luggage <= 50 && request.resource.data.createdAt == request.time;allow read: if signedIn() && (resource.data.userId == request.auth.uid || admin());allow update,delete: if admin();}\n  match /wellnessRequests/{id}{allow create: if signedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.email == request.auth.token.email && request.resource.data.travellers is int && request.resource.data.travellers >= 1 && request.resource.data.travellers <= 30 && request.resource.data.status == 'requested' && request.resource.data.createdAt == request.time;allow read: if signedIn() && (resource.data.userId == request.auth.uid || admin());allow update,delete: if admin();}\n  match /wellnessPackages/{id}{allow read: if true;allow write: if admin();}\n  match /publicContent/{id}{allow read: if true;allow write: if admin();}
  match /{document=**}{allow read,write: if false;}
 }
}